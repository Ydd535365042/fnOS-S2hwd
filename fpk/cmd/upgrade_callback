#!/bin/bash
# 升级后：恢复脚本、重装机服务
set -u
APP_NAME="${TRIM_APPNAME:-fnOS-S2}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
DEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
BK="$(cat "${VAR_DIR}/last_backup" 2>/dev/null || true)"
if [ -n "$BK" ] && [ -d "$BK/scripts" ]; then
    cp -a "$BK/scripts/." "$VAR_DIR/scripts/" 2>/dev/null
fi
# 原生后端升级；旧硬件未就绪时不停止原有控制服务，不改引导文件。
NATIVE_DIR=""
for d in "$DEST/server" "$DEST/target/server" "/var/apps/$APP_NAME/target/server"; do
    if [ -f "$d/s2deploy.py" ]; then NATIVE_DIR="$d"; break; fi
done
if [ -z "$NATIVE_DIR" ]; then echo "原生部署模块缺失" >> "$VAR_DIR/server.log"; exit 1; fi
python3 "$NATIVE_DIR/s2deploy.py" install "$NATIVE_DIR/.." >> "$VAR_DIR/server.log" 2>&1 || exit 1
python3 "$NATIVE_DIR/s2deploy.py" scripts "$NATIVE_DIR/.." --scripts-dir "$VAR_DIR/scripts" >> "$VAR_DIR/server.log" 2>&1 || exit 1

# 升级已经安装的可选代理；不能让旧的无认证 root 监听继续常驻。
if systemctl cat s2hw-agent.service >/dev/null 2>&1; then
    if ! systemctl stop s2hw-agent.service >/dev/null 2>&1; then
        echo '安全升级失败：无法停止旧硬件代理，请以 root 检查服务状态。' >> "$VAR_DIR/server.log"
        exit 1
    fi
    systemctl disable s2hw-agent.service >/dev/null 2>&1 || true
    AGENT_INSTALL=""
    for d in "${DEST}/agent" "${DEST}/target/agent" \
             "/var/apps/${APP_NAME}/agent" "/var/apps/${APP_NAME}/target/agent"; do
        if [ -f "$d/install-hw-agent.sh" ]; then AGENT_INSTALL="$d/install-hw-agent.sh"; break; fi
    done
    if [ -z "$AGENT_INSTALL" ] || ! bash "$AGENT_INSTALL" >> "$VAR_DIR/server.log" 2>&1; then
        echo '安全升级：硬件代理已停止，重新安装失败，请查看日志后重新部署代理。' >> "$VAR_DIR/server.log"
    fi
fi
exit 0
