#!/bin/bash
# 卸载后：按向导选择决定是否清理数据
set -u
APP_NAME="${TRIM_APPNAME:-fnOS-S2}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
if [ -f /usr/local/lib/fnos-s2/s2deploy.py ]; then
    python3 /usr/local/lib/fnos-s2/s2deploy.py uninstall || exit 1
fi
if [ "${wizard_data_action:-keep}" = "delete" ]; then
    # 只清理经过归属校验的私有数据，共享脚本与引导备份保留。
    python3 /usr/local/lib/fnos-s2/s2deploy.py remove-data "$VAR_DIR" --app-name "$APP_NAME" || exit 1
fi
exit 0
