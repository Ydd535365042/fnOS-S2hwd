#!/bin/bash
# 安装后：写 settings.conf、生成预置修复脚本、部署全部硬件定制脚本、按需安装开机灯光服务
set -u
APP_NAME="${TRIM_APPNAME:-fnOS-S2}"
ETC_DIR="${TRIM_PKGETC:-/var/apps/${APP_NAME}/etc}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
DEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
# fnOS 正常安装会注入 TRIM_DATA_SHARE_PATHS（config/resource 声明了 data-share）。
# 万一没注入，set -u 也不能把整个安装回调打断：共享目录里的 README 只是便利提示，
# 缺了它 settings.conf / 出厂脚本 / 固件部署仍必须照常完成。
SHARE_DIR="${TRIM_DATA_SHARE_PATHS:-}"
SHARE_DIR="${SHARE_DIR%%:*}"

mkdir -p "$ETC_DIR" "$VAR_DIR/scripts" "$VAR_DIR/jobs" "$VAR_DIR/logs"

# ---- settings.conf：端口的唯一权威来源 ----
PORT="${wizard_port:-${TRIM_SERVICE_PORT:-18899}}"
case "$PORT" in ''|*[!0-9]*) echo '端口无效' > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1 ;; esac
if [ "${#PORT}" -gt 5 ] || [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then
    echo '端口范围需在 1024-65535 之间' > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
fi
TOKEN=""
if [ "${wizard_enable_token:-false}" = "true" ]; then TOKEN="${wizard_token:-}"; fi
# 与 config_callback 同一道兜底：settings.conf 是给 cmd/main 用 `.` 加载的，
# 向导 pattern 只约束 UI，绕过向导传进来的空格 / 引号 / $() 不能写进文件。
case "$TOKEN" in
    *[!A-Za-z0-9._~+-]*) TOKEN="" ;;
esac
BOOT_SVC="${wizard_install_boot_service:-false}"
{
    echo "# S2 硬件控制台 运行时配置（由 install_callback / config_callback 写入）"
    echo "PORT=${PORT}"
    echo "TOKEN=${TOKEN}"
    echo "INSTALL_BOOT_SERVICE=${BOOT_SVC}"
} > "${ETC_DIR}/settings.conf"
chmod 600 "${ETC_DIR}/settings.conf"

# ---- 定位 fpk 内嵌的硬件脚本目录（兼容新旧 fnOS 的 APPDEST 布局）----
FIRMWARE_DIR=""
if   [ -d "${DEST}/firmware" ]; then        FIRMWARE_DIR="${DEST}/firmware"
elif [ -d "${DEST}/target/firmware" ]; then FIRMWARE_DIR="${DEST}/target/firmware"
elif [ -d "/var/apps/${APP_NAME}/firmware" ]; then        FIRMWARE_DIR="/var/apps/${APP_NAME}/firmware"
elif [ -d "/var/apps/${APP_NAME}/target/firmware" ]; then FIRMWARE_DIR="/var/apps/${APP_NAME}/target/firmware"
fi

# ---- 原生硬件部署：不自动写 DTB / fnEnv，不运行旧 install_all / deploy ----
NATIVE_DIR=""
for d in "$DEST/server" "$DEST/target/server" "/var/apps/$APP_NAME/target/server"; do
    if [ -f "$d/s2deploy.py" ]; then NATIVE_DIR="$d"; break; fi
done
if [ -z "$NATIVE_DIR" ]; then
    echo "原生部署模块缺失" >> "$VAR_DIR/server.log"
    exit 1
fi
python3 "$NATIVE_DIR/s2deploy.py" install "$NATIVE_DIR/.." >> "$VAR_DIR/server.log" 2>&1 || exit 1
python3 "$NATIVE_DIR/s2deploy.py" scripts "$NATIVE_DIR/.." --scripts-dir "$VAR_DIR/scripts" >> "$VAR_DIR/server.log" 2>&1 || exit 1
if [ "$BOOT_SVC" = "true" ]; then
    python3 /etc/s2hwctl/patches.d/s2-lights/runner.py apply >> "$VAR_DIR/server.log" 2>&1 || echo "灯光美化未启用，请在控制页查看模块状态和安装日志" >> "$VAR_DIR/server.log"
fi

# ---- 共享目录里放一份 README，方便用户从「文件管理 → 应用文件」丢脚本进来 ----
if [ -n "$SHARE_DIR" ] && [ -d "$SHARE_DIR" ]; then
    cat > "$SHARE_DIR/把脚本拖到这里.txt" <<'EOT'
把 .sh 脚本复制到本目录，即可在 S2 硬件控制台的「脚本修复」页面中看到并执行。
也可直接在页面里把脚本拖进虚线框上传。
EOT
fi

# ---- CLI 软链由 resource/usr-local-linker 处理，这里兜底一次 ----
[ -f "${DEST}/bin/s2hwctl-cli" ] && install -m 755 "${DEST}/bin/s2hwctl-cli" /usr/local/bin/s2hwctl-cli 2>/dev/null

exit 0
