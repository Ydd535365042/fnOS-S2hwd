[
    {
        "stepTitle": "访问端口",
        "items": [
            {
                "type": "text",
                "field": "wizard_port",
                "label": "Web 管理端口",
                "initValue": "18899",
                "rules": [
                    { "required": true, "message": "端口不能为空" },
                    { "pattern": "^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "message": "端口需为 1024-65535 的数字" }
                ]
            },
            {
                "type": "tips",
                "helpText": "保存后应用会自动重启并使用新端口，请稍后用新端口打开。修改端口不会改动已设置的访问口令。"
            }
        ]
    },
    {
        "stepTitle": "访问口令",
        "items": [
            {
                "type": "password",
                "field": "wizard_token",
                "label": "设置新口令",
                "initValue": "",
                "rules": [
                    { "pattern": "^([A-Za-z0-9._~+-]{6,64})?$", "message": "口令 6–64 位，只能用字母、数字和 - _ . ~ + ，不要含空格或引号" }
                ]
            },
            {
                "type": "switch",
                "field": "wizard_clear_token",
                "label": "清除访问口令",
                "initValue": "false"
            },
            {
                "type": "tips",
                "helpText": "这里看不到当前口令；控制台「概览 → 访问端口」里显示口令是否已开启。<br>留空且不清空 = 保持现有口令不变，只改端口也安全。<br>填写新口令 = 启用或更新口令（6–64 位字母、数字或 - _ . ~ +）；勾选「清除访问口令」= 关闭口令保护。<br><b>未启用口令时，硬件控制、配置修改和脚本执行仅允许在设备本机操作</b>。保存后应用会重启，刷新控制台页面输入新口令即可。"
            }
        ]
    }
]
