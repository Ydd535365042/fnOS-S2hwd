[Unit]
Description=S2 硬件操作代理（root，供 S2硬件控制台调用）
After=network.target

[Service]
Type=simple
Environment=S2_AGENT_PORT=8899
Environment=S2_HWCTL_DIR=/var/apps/fnOS-S2/target/server
Environment=S2_AGENT_KEY_FILE=/var/apps/fnOS-S2/etc/agent.key
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/sbin/s2hw-agent.py
Restart=always
RestartSec=3
# 非关键代理服务：降权。IO 用 best-effort 最低优先级而不是 idle：
# idle 在 RAID 重建等持续 IO 下可能饿死，网页上的写配置会卡住。
# 内存软上限 64M：Python + hwinfo 模块 + smartctl 子进程都算在这个 cgroup 里。
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=64M

[Install]
WantedBy=multi-user.target
