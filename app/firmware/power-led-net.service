[Unit]
Description=Power LED network link indicator (green=link up, red blink=no link)
After=local-fs.target systemd-udev-settle.service
Before=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/power-led-net.sh
Restart=always
RestartSec=3
# 非关键指示灯服务：降权，避免和 fan-control / 磁盘 IO 抢资源
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryHigh=32M

[Install]
WantedBy=multi-user.target
