#!/bin/bash
# =============================================================
# fanctl —— 风扇控制命令行
#
#   fanctl status              查看当前状态（占空比/CPU/各盘温度）
#   fanctl temps               只看温度
#
# v5 起取消 manual 固定挡位滑杆，全程按 /etc/fan-control.conf 的
# 三档策略（quiet / performance / custom）+ 4 锚点曲线温控，
# 切换策略请走 Web UI「风扇控制」卡片。
# =============================================================
set -u

RUN_DIR=/var/lib/fan-control
STATUS_FILE="$RUN_DIR/status"

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-status}" in
    status)
        if [ -r "$STATUS_FILE" ]; then
            cat "$STATUS_FILE"
            echo
            echo "（数据源：风扇守护进程实时写入，3 秒刷新一次）"
        else
            echo "状态文件尚不存在：$STATUS_FILE"
            echo "请确认 fan-control.service 是否已启动： systemctl status fan-control"
            exit 1
        fi
        ;;
    temps)
        if [ -r "$STATUS_FILE" ]; then
            grep -E '^(cpu_temp|hdd_max_temp|hdd_source|disks|duty_pct)=' "$STATUS_FILE"
        else
            echo "无状态文件，风扇服务可能未运行"
            exit 1
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "❌ 未知命令: $1"
        echo "（v5 起取消 auto/manual/level 子命令，全程温控；切换策略请走 Web UI）"
        usage
        exit 1
        ;;
esac
exit 0
