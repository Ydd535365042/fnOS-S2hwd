cmd_status() {
    say "== S2 è‡ªæ„ˆæœ€å°åŒ… Â· ç°çŠ¶ï¼ˆåªè¯»ï¼‰"
    say "  åŒ…ç‰ˆæœ¬      : $VERSION"
    d=$(T "$DTB_TARGET"); r=$(T "$FALLBACK_DTB")
    say "  æœ¬åŒ… dtb    : $( [ -f "$d" ] && printf '%s  %s B' "$(md5_of "$d")" "$(stat -c%s "$d")" || echo ç¼ºå¤±)  (æœŸæœ› $DTB_MD5 / $DTB_SIZE B)"
    say "  r5s åä¸‹ dtb: $( [ -f "$r" ] && printf '%s  %s B' "$(md5_of "$r")" "$(stat -c%s "$r")" || echo ç¼ºå¤±)"
    say "  fdtfile     : $(grep -m1 '^fdtfile' "$(T "$FNENV")" 2>/dev/null || echo æœªæ‰¾åˆ°)"
    say "  æœŸæœ› fdtfile: $FDTFILE_LINE"
    say "  å®šç¨¿ sha256 : $DTB_SHA256"
    say "  ç›®æ ‡ sha256 : $( [ -f "$d" ] && sha256sum "$d" 2>/dev/null | cut -d' ' -f1 || echo ç¼ºå¤±)"
    say "  è¿è¡Œæ€ model: $(model_now)ï¼ˆä»…ä¾›å‚è€ƒï¼Œä¸ä½œåˆ¤æ®ï¼‰"
    say "  æœŸæœ› model  : $EXPECTED_MODEL"
    for u in $UNITS; do
        printf '  %-32s enabled=%-10s active=%s\n' "$u" "$(u_state "$u")" \
               "$(live && systemctl is-active "$u" 2>&1 | head -n1 || echo sandbox)"
    done
    say "  å®ˆæŠ¤é…ç½®    : $( [ -f "$(T "$GUARD_CONF")" ] && echo "å­˜åœ¨ $(T "$GUARD_CONF")" || echo æ— )"
    say "  éš”ç¦»åŒº      : $( [ -d "$(T "$GUARD_STATE")/quarantine" ] && ls -1 "$(T "$GUARD_STATE")/quarantine" 2>/dev/null | wc -l || echo 0) é¡¹"
    detect_rivals; report_rivals
    if [ -x "$(T "$GUARD")" ]; then
        say "  å®ˆå«è‡ªè¿°    :"
        bash "$(T "$GUARD")" --status 2>/dev/null | sed -n '1,6p' | sed 's/^/    /'
    fi
    say "  æœ¬åŒ…ç»“è®º    : $(is_installed && echo å·²å®‰è£… || echo æœªå®‰è£…)"
    say "  å¸è½½        : sudo bash $0 --uninstall"
}

is_installed() {
    [ -f "$(T "$DTB_TARGET")" ] && [ -f "$(T "$GUARD")" ] && [ -f "$(T "/etc/systemd/system/fix-fnenv.service")" ]
}

state_path() { printf '%s' "$(T "$GUARD_STATE")/install.state"; }

cmd_install() {
    need_root '--install'
    say "== å®‰è£… S2 è‡ªæ„ˆæœ€å°åŒ… v$VERSION"
    step 0 'é¢„æ£€'
    [ -f "$(T "$FNENV")" ] || die "æ‰¾ä¸åˆ° $FNENV"
    say "    å½“å‰ fdtfile: $(grep -m1 '^fdtfile' "$(T "$FNENV")" || echo æ— )"
    say "    è¿è¡Œæ€ model: $(model_now)"
    step '0.1' 'çœ‹æœºå™¨ä¸Šè¿˜æœ‰è°åœ¨ç®¡ dtb'
    detect_rivals; report_rivals
    if [ "$DRYRUN" = 1 ]; then
        say ""
        say "    dry-runï¼šä»¥ä¸‹åŠ¨ä½œä¸ä¼šæ‰§è¡Œ"
        while IFS='|' read -r mode target src md5; do
            [ -n "${mode:-}" ] || continue
            say "      would install -m $mode <è½½è·/$src> -> $target"
        done <<EOF
$MANIFEST
EOF
        say "      would write $GUARD_CONFï¼ˆ$(printf '%s\n' "$GUARD_CONF_TEXT" | grep -c '=') è¡Œï¼‰"
        say "      would fix $FNENV -> $FDTFILE_LINE"
        say "      would remount rw /bootï¼ˆè‹¥å®ƒæœ¬æ¥æ˜¯åªè¯»ï¼‰ï¼Œè£…å®Œå†æŒ‚å›åªè¯»"
        say "      would enable: $ENABLE"
        say "      would run $GUARD --bootï¼ˆç¬¬ä¸€æ—¶é—´å‹åˆ¶ä¸Šé¢åˆ—çš„é’©å­ï¼‰"
        [ -f "$(T "/etc/systemd/system-shutdown/zz-s2-dtb-guard.sh")" ] \
            && say "      would retire /etc/systemd/system-shutdown/zz-s2-dtb-guard.shï¼ˆæ—§ç‰ˆå…³æœºé’©å­ï¼Œç•™åº•ååˆ ï¼‰"
        return 0
    fi

    step 1 'è§£åŒ…å¹¶æ ¡éªŒè½½è·'
    unpack; verify_manifest

    step 2 'å¤‡ä»½å°†è¢«è¦†ç›–/åˆ é™¤çš„ä¸€åˆ‡'
    bkdir="$BKROOT/s2-heal-$STAMP"; bkdir=$(T "$bkdir")
    mkdir -p "$bkdir" || die "å»ºä¸äº†å¤‡ä»½ç›®å½• $bkdir"
    : > "$bkdir/targets.list"
    st=$(state_path); mkdir -p "$(dirname "$st")" || die "å»ºä¸äº† $GUARD_STATE"
    prev_new=''; prev_orig=''
    if [ -f "$st" ]; then                    # é‡è£…è¦æ²¿ç”¨ç¬¬ä¸€æ¬¡çš„çŠ¶æ€ï¼Œå¦åˆ™ä¼šæŠŠâ€œè£…åæ‰å‡ºç°â€å½“â€œåŸæ¥å°±æœ‰â€
        prev_new=$(sed -n 's/^NEW //p' "$st")
        prev_orig=$(grep -m1 '^FDTFILE_ORIG=' "$st" | cut -d= -f2-)
        say "    å·²æœ‰å®‰è£…çŠ¶æ€ï¼šæ²¿ç”¨åŸ fdtfile='${prev_orig}'ã€NEW åå• $(printf '%s\n' "$prev_new" | grep -c .) é¡¹"
    fi
    is_prev_new() { printf '%s\n' "$prev_new" | grep -qxF "$1"; }
    : > "$st.new"
    printf 'TS=%s\n' "$STAMP" >> "$st.new"
    printf 'FDTFILE_ORIG=%s\n' "${prev_orig:-$(grep -m1 '^fdtfile=' "$(T "$FNENV")" | cut -d= -f2-)}" >> "$st.new"
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        p=$(T "$target")
        if is_prev_new "$target"; then
            printf 'NEW %s\n' "$target" >> "$st.new"
            say "    $target æ˜¯æœ¬åŒ…ä¸Šæ¬¡è£…çš„ï¼Œä¸å†å¤‡ä»½"
            continue
        fi
        printf '%s\n' "$p" >> "$bkdir/targets.list"
        if [ -e "$p" ]; then
            cp -a "$p" "$bkdir/$(basename "$p").orig" && say "    å¤‡ä»½ $target -> $(basename "$bkdir/$(basename "$p").orig")"
            [ -e "${p}.orig-bak" ] || cp -a "$p" "${p}.orig-bak" 2>/dev/null || true
        else
            printf 'NEW %s\n' "$target" >> "$st.new"
            say "    $target åŸæœ¬ä¸å­˜åœ¨ï¼ˆå¸è½½æ—¶åˆ æ‰ï¼‰"
        fi
    done <<EOF
$MANIFEST
EOF
    cp -a "$(T "$FNENV")" "$bkdir/fnEnv.txt.orig" && say "    å¤‡ä»½ fnEnv.txt"
    printf '%s\n' "$(T "$FNENV")" >> "$bkdir/targets.list"
    tgz=$(T "$BKROOT/s2-heal-$STAMP.tar.gz")
    # shellcheck disable=SC2046
    tar -czPf "$tgz" $(cat "$bkdir/targets.list") 2>/dev/null && say "    $tgz  $(stat -c%s "$tgz" 2>/dev/null) B"
    mv -f "$st.new" "$st"

    # 1.1.1 åŠæ›´æ—©åœ¨ /etc/systemd/system-shutdown ç•™äº†ä¸€ä¸ªè‡ªå®¶å…³æœºé’©å­ï¼ˆåªåšç¯æ•ˆï¼‰ã€‚
    # ç°åœ¨ç¯æ•ˆå½’ç¾åŒ–åŒ…ï¼Œæœ¬åŒ…ä¸å†ç¢°å…³æœºé˜¶æ®µï¼šå¸¦è‡ªå®¶æŒ‡çº¹çš„æ—§æ–‡ä»¶ç•™åº•ååˆ æ‰ã€‚
    hook=$(T "/etc/systemd/system-shutdown/zz-s2-dtb-guard.sh")
    if [ -f "$hook" ] && grep -q 's2-dtb-guard.sh --shutdown' "$hook" 2>/dev/null; then
        cp -a "$hook" "$bkdir/zz-s2-dtb-guard.sh.legacy" \
            && say "    ç•™åº•æ—§ç‰ˆå…³æœºé’©å­ -> zz-s2-dtb-guard.sh.legacy"
        rm -f "$hook" && say "    é€€å½¹æ—§ç‰ˆå…³æœºé’©å­ï¼šæœ¬åŒ…ä¸å†ç®¡å…³æœºé˜¶æ®µï¼ˆç¯æ•ˆå½’ç¾åŒ–åŒ…ï¼‰"
    fi

    step 3 'è½ç›˜ï¼ˆæŒ‰åŒä¸€ä»½æ¸…å•ï¼‰'
    boot_rw
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        p=$(T "$target")
        mkdir -p "$(dirname "$p")" || die "å»ºä¸äº† $(dirname "$p")"
        unlock_file "$p"
        install -m "$mode" "$TMPDIR_PAYLOAD/$src" "$p" || die "å†™å…¥ $target å¤±è´¥"
        got=$(md5_of "$p")
        [ "$got" = "$md5" ] || die "$target è½ç›˜ md5 ä¸ç¬¦ $got != $md5"
        say "    $target  $(stat -c%s "$p") B  md5=$got"
    done <<EOF
$MANIFEST
EOF

    step 4 "å†™å®ˆæŠ¤é…ç½® $GUARD_CONF"
    printf '%s\n' "$GUARD_CONF_TEXT" > "$(T "$GUARD_CONF")" || die "å†™ $GUARD_CONF å¤±è´¥"
    chmod 644 "$(T "$GUARD_CONF")"

    step 5 'æ”¹ fnEnv'
    cur=$(grep -m1 '^fdtfile=' "$(T "$FNENV")" | cut -d= -f2-)
    if [ "$cur" = "rockchip/$DTB_NAME" ]; then
        say "    å·²æ˜¯ $FDTFILE_LINEï¼Œæ— éœ€æ”¹åŠ¨"
    else
        unlock_file "$(T "$FNENV")"
        sed -i -E "s|^[[:space:]]*fdtfile[[:space:]]*=.*|$FDTFILE_LINE|" "$(T "$FNENV")" || die "æ”¹ fdtfile å¤±è´¥"
        say "    ç”± '$cur' æ”¹ä¸º '$FDTFILE_LINE'"
    fi
    cp -a "$(T "$FNENV")" "$(T "$SNAPSHOT")" 2>/dev/null && say "    å¿«ç…§ -> $SNAPSHOT"

    step 6 'å¯ç”¨å®ˆæŠ¤'
    for u in $ENABLE; do
        tg=${u%%:*}; un=${u##*:}
        mkdir -p "$(T "/etc/systemd/system/$tg.wants")" || die "å»ºä¸äº† $tg.wants"
        ln -sfn "$(T "/etc/systemd/system/$un")" "$(T "/etc/systemd/system/$tg.wants/$un")" \
            && say "    $un â†’ $tg"
    done
    if live; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
    for u in $UNITS; do
        printf '    %-32s enabled=%-10s\n' "$u" "$(u_state "$u")"
    done

    step 7 'ç¬¬ä¸€æ—¶é—´å‹åˆ¶å…¶ä»–é’©å­'
    if [ -x "$(T "$GUARD")" ] || [ -f "$(T "$GUARD")" ]; then
        bash "$(T "$GUARD")" --boot 2>&1 | sed 's/^/    /'
    else
