# è½½è·ä»¥çœŸæ­£çš„ tar.gz äºŒè¿›åˆ¶è¿½åŠ åœ¨æœ¬æ–‡ä»¶æœ«å°¾ã€æ ‡è®°è¡Œä¹‹åï¼›è§£åŒ…æ—¶è‡ªå®šä½ï¼Œä¸å†™æ­»è¡Œå·
M1='#__S2_PAYLOAD'; M2='_BELOW__'; PAYLOAD_MARK="$M1$M2"
unpack() {
    TMPDIR_PAYLOAD=$(mktemp -d /tmp/s2run.XXXXXX) || die "æ— æ³•åˆ›å»ºä¸´æ—¶ç›®å½•"
    ln=$(grep -an "^$PAYLOAD_MARK\$" "$SELF" 2>/dev/null | head -n1 | cut -d: -f1)
    [ -n "$ln" ] || die "æ‰¾ä¸åˆ°è½½è·æ ‡è®°ï¼ˆè¿™ä¸ªæ–‡ä»¶ä¸æ˜¯æ ‡å‡†è‡ªè§£å‹åŒ…ï¼‰"
    tail -n +"$((ln + 1))" "$SELF" > "$TMPDIR_PAYLOAD/payload.tar.gz" \
        || die "è½½è·æŠ½å–å¤±è´¥ï¼ˆåŒ…å¯èƒ½è¢«æˆªæ–­ï¼‰"
    got=$(sha256sum "$TMPDIR_PAYLOAD/payload.tar.gz" | awk '{print $1}')
    [ "$got" = "$PAYLOAD_SHA256" ] || die "è½½è· SHA256 ä¸ç¬¦ï¼š$got != $PAYLOAD_SHA256ï¼ˆåŒ…å·²æŸåï¼‰"
    tar -xzf "$TMPDIR_PAYLOAD/payload.tar.gz" -C "$TMPDIR_PAYLOAD" || die "è½½è·è§£åŒ…å¤±è´¥"
    say "    è½½è·æ ¡éªŒé€šè¿‡ï¼ˆsha256 ä¸å¤´éƒ¨ä¸€è‡´ï¼‰"
}

verify_manifest() {
    bad=0
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        f="$TMPDIR_PAYLOAD/$src"
        if [ ! -f "$f" ]; then say "    !! è½½è·ç¼ºæ–‡ä»¶ $src"; bad=1; continue; fi
        got=$(md5sum "$f" | awk '{print $1}')
        [ "$got" = "$md5" ] || { say "    !! $src md5 ä¸ç¬¦ $got != $md5"; bad=1; }
    done <<EOF
$MANIFEST
EOF
    [ "$bad" -eq 0 ] || die "æ¸…å•æ ¡éªŒå¤±è´¥"
    say "    æ¸…å• $(printf '%s\n' "$MANIFEST" | grep -c '|') é¡¹å…¨éƒ¨ä¸€è‡´"
}

# è£…ä¹‹å‰ / å¸ä¹‹å‰å…ˆçœ‹ä¸€çœ¼æœºå™¨ä¸Šè¿˜æœ‰è°åœ¨ç®¡ dtb â€”â€” åªæç¤ºï¼Œä¸æ‹¦
detect_rivals() {
    RV=''
    for d in "$R/etc/systemd/system" "$R/usr/lib/systemd/system" "$R/lib/systemd/system"; do
        [ -d "$d" ] || continue
        for f in "$d"/*.service "$d"/*.timer; do
            [ -f "$f" ] || continue
            b=${f##*/}
            case "$b" in
                fix-fnenv.service|s2-dtb-guard.service|s2-dtb-guard.path|\
                s2-dtb-guard-realize.service|scsi-rescan.service) continue ;;
            esac
            if grep -qE 'fnEnv|fdtfile|/boot/dtb|s2ver\.sh|selfheal' "$f" 2>/dev/null; then
                RV="$RV $b"
            fi
        done
    done
    for d in "$R/usr/lib/systemd/system-shutdown" "$R/etc/systemd/system-shutdown"; do
        [ -d "$d" ] || continue
        for f in "$d"/*; do
            [ -f "$f" ] || continue
            [ "${f##*/}" = "zz-s2-dtb-guard.sh" ] && continue
            case "${f##*/}" in mdadm.shutdown|nutshutdown) continue ;; esac
            RV="$RV shutdown:${f##*/}"
        done
    done
}
report_rivals() {
    if [ -z "$RV" ]; then say "    æœªå‘ç°å…¶ä»–ä¼šæ”¹ fnEnv/dtb çš„é’©å­"; return 0; fi
    say "    å‘ç°å…¶ä»–è‡ªæ„ˆé’©å­ï¼ˆè£…å®Œä¼šç«‹åˆ»å‹åˆ¶ï¼Œä¸åŠ¨å®ƒä¸€ä¸ªå­—èŠ‚ï¼‰ï¼š"
    for x in $RV; do say "      - $x"; done
}

cmd_check() {
