    fi

    step 8 'è‡ªæ£€'
    boot_ro
    bad=0
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        p=$(T "$target")
        if [ -f "$p" ] && [ "$(md5_of "$p")" = "$md5" ]; then
            say "    âœ” ${target}"
        else
            say "    âœ˜ å†…å®¹ä¸ä¸€è‡´ ${target}"; bad=1
        fi
    done <<EOF
$MANIFEST
EOF
    fv=$(grep -m1 '^fdtfile=' "$(T "$FNENV")" | cut -d= -f2-)
    if [ -f "$(T "/boot/dtb/rockchip/${fv#rockchip/}")" ]; then
        say "    âœ” fdtfile=$fv ç›®æ ‡å­˜åœ¨"
    else
        say "    âœ˜ fdtfile=$fv ç›®æ ‡ä¸å­˜åœ¨"; bad=1
    fi
    say ""
    say "  å¤‡ä»½ç›®å½•ï¼š$bkdir"
    say "  å¸è½½    ï¼šsudo bash $0 --uninstall"
    got=$(sha256sum "$(T "$DTB_TARGET")" 2>/dev/null | cut -d' ' -f1)
    if [ -n "$got" ] && [ "$got" = "$DTB_SHA256" ]; then
        say "  dtb å·²å°±ä½ï¼šsha256 ä¸è®¾å®šå€¼ä¸€è‡´ï¼ˆ$gotï¼‰"
        say "  ä¸‹æ¬¡å¼€æœºå¿…ç„¶åŠ è½½è¿™ä»½ï¼›æœ¬æ¬¡è‹¥åˆšä»æ—§å†…å®¹æ¢è¿‡æ¥ï¼Œé‡å¯åç”Ÿæ•ˆï¼š reboot"
    else
        say "  dtb sha256 ä¸è®¾å®šå€¼ä¸ä¸€è‡´ï¼š${got:-è¯»å–å¤±è´¥}ï¼ˆåº”ä¸º $DTB_SHA256ï¼‰"
        say "  æ–‡ä»¶å†…å®¹ä¸å¯¹ â†’ /boot åªè¯»æˆ–è¢« immutable æŒ¡ä½ï¼Œçœ‹ä¸Šé¢ âœ˜ é¡¹"
    fi
    [ "$bad" -eq 0 ] || { say "âš  æœ‰æ ¸å¯¹ä¸ä¸€è‡´é¡¹ï¼Œè§ä¸Šé¢ âœ˜"; exit 1; }
}

cmd_uninstall() {
    need_root '--uninstall'
    say "== å¸è½½ S2 è‡ªæ„ˆæœ€å°åŒ… v$VERSIONï¼ˆä¸å®‰è£…åŒä¸€ä»½æ¸…å•ï¼‰"
    step 0 'ç›˜ç‚¹'
    n=0
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        if [ -e "$(T "$target")" ]; then say "    å­˜åœ¨ $target"; n=$((n+1)); else say "    ç¼ºå¤± $target"; fi
    done <<EOF
$MANIFEST
EOF
    [ -f "$(T "$SNAPSHOT")" ] && { say "    å­˜åœ¨ $SNAPSHOT"; n=$((n+1)); }
    say "    å½“å‰ fdtfile: $(grep -m1 '^fdtfile' "$(T "$FNENV")" 2>/dev/null || echo æ— )"
    [ "$n" -gt 0 ] || { say "    ï¼ˆæ²¡æœ‰æœ¬åŒ…è½ç‚¹ï¼Œå¯èƒ½å·²å¸è¿‡ï¼‰"; }

    st="$(state_path)"
    orig_fdt=''
    [ -f "$st" ] && orig_fdt=$(grep -m1 '^FDTFILE_ORIG=' "$st" | cut -d= -f2-)
    step '0.1' 'çœ‹æœºå™¨ä¸Šè¿˜æœ‰è°åœ¨ç®¡ dtb'
    detect_rivals; report_rivals
    if [ -z "$RV" ]; then
        say ""
        say "    æœºå™¨ä¸Šæ²¡æœ‰åˆ«çš„è‡ªæ„ˆå±‚åœ¨ç®¡ dtb/fdtfileã€‚"
        say "    å¸è½½ä¼šæ‹†æ‰æœ¬åŒ…çš„é’©å­ä¸è‡ªæ„ˆï¼Œdtb ä¸ fdtfile ä¿æŒç°çŠ¶ï¼ˆå…¼å®¹ dtb ç•™ç€ï¼Œç…§æ ·èƒ½å¼€æœºï¼‰ï¼Œ"
        say "    ä½†ä¹‹å OTA å†æ”¹ fnEnv å°±æ²¡äººç®¡äº†ã€‚"
        say ""
        say "    âš  è¿™é‡Œè¿˜æœ‰ä¸€å±‚é£é™©ï¼Œåˆ«æ¼çœ‹ï¼š"
        say "      fdtfile ä»æŒ‡å‘ /boot/dtb/rockchip/$(basename "$DTB_TARGET")ã€‚ä»¥å OTA è‹¥é‡åˆ· /boot/dtbï¼Œ"
        say "      è¿™ä¸ªæ–‡ä»¶æ²¡äº†ï¼ŒU-Boot æŒ‰ fdtfile åŠ è½½ä¼šå¤±è´¥â€”â€”æ•…éšœåœ¨å¼€æœºé˜¶æ®µï¼Œè®¾å¤‡ç›´æ¥èµ·ä¸æ¥ï¼Œ"
        say "      ä¸æ˜¯è¿›ç³»ç»Ÿåæ‰å‘ç°ï¼ŒSSH ä¹Ÿè¿›ä¸å»ã€‚"
        say "      æ‰€ä»¥è®¾å¤‡ä¾§ä¼šç•™ä¸€ä»½å‚è€ƒå‰¯æœ¬ï¼ˆå‡  KBï¼‰ï¼š$GUARD_STATE/dtb.ref"
        say "      çœŸèµ·ä¸æ¥æ—¶ï¼Œæ•‘æ´/ä¸²å£ä¸‹ä¸€æ¡å‘½ä»¤å›å¡«ï¼š"
        say "        sudo install -D -m 644 $GUARD_STATE/dtb.ref /boot/dtb/rockchip/$(basename "$DTB_TARGET")"
        say "      æƒ³è®©æœºå™¨å½»åº•å›åˆ°â€œä¸ä¾èµ–å®šåˆ¶ dtbâ€ï¼Œå†æŠŠ fnEnv çš„ fdtfile æ”¹æˆåŸå‚æ¿å‹ï¼ˆè‡ªè¡Œç¡®è®¤æ¿å‹åï¼‰ã€‚"
        if [ "$DRYRUN" = 1 ]; then
            say "    ï¼ˆdry-runï¼šçœŸå®æ‰§è¡Œä¼šåœ¨æ­¤è¯¢é—® y/Nï¼‰"
        elif [ "$YES" = 1 ]; then
            say "    --yes å·²ç¡®è®¤ï¼Œç»§ç»­"
        elif [ -t 0 ]; then
            printf '    ç»§ç»­å¸è½½ï¼Ÿ[y/N] '
            read -r ans
            case "$ans" in y|Y|yes|YES) say "    å·²ç¡®è®¤" ;; *) die "ç”¨æˆ·å–æ¶ˆå¸è½½" ;; esac
        else
            die "éäº¤äº’ç¯å¢ƒï¼šç¡®è®¤ç»§ç»­è¯·åŠ  --yesï¼ˆä¾‹å¦‚ sudo bash $0 --uninstall --yesï¼‰"
        fi
    else
        say "    æœ‰å…¶ä»–è‡ªæ„ˆå±‚åœ¨ç®¡ dtbï¼Œå¸è½½åç”±å®ƒä»¬ç»´æŒ"
    fi
    if [ "$DRYRUN" = 1 ]; then
        say ""
        say "    dry-runï¼šä»¥ä¸‹åŠ¨ä½œä¸ä¼šæ‰§è¡Œ"
        say "      would stop+disable: $UNITS"
        say "      would run $GUARD --releaseï¼ˆåˆ  claimã€æ¸… drop-inã€éš”ç¦»é¡¹æ”¾å›ï¼›dtb ä¸åŠ¨ï¼‰"
        while IFS='|' read -r mode target src md5; do
            [ -n "${mode:-}" ] || continue
            case "$target" in
                /boot/dtb/rockchip/*) [ -e "$(T "$target")" ] && say "      would keep $targetï¼ˆå…¼å®¹ dtbï¼Œä¸è¿˜åŸï¼‰" ;;
                *) [ -e "$(T "$target")" ] && say "      would remove $targetï¼ˆæœ‰ .orig-bak çš„å…ˆè¿˜åŸï¼‰" ;;
            esac
        done <<EOF
$MANIFEST
EOF
        say "      would remove $GUARD_CONF / $SNAPSHOT / $GUARD_STATEï¼ˆä¿ç•™ dtb.refï¼‰"
        [ -f "$(T "/etc/systemd/system-shutdown/zz-s2-dtb-guard.sh")" ] \
            && say "      would remove æ—§ç‰ˆå…³æœºé’©å­ zz-s2-dtb-guard.shï¼ˆå·²æ”¶è¿›å¤‡ä»½ tarï¼‰"
        say "      would keep $FNENV åŸæ ·ï¼ˆfdtfile ä¸æ”¹ï¼‰"
        return 0
    fi

    step 1 'æ•´åŒ…å¤‡ä»½ï¼ˆåæ‚”è¯ï¼‰'
    tgz=$(T "$BKROOT/s2-heal-uninstall-$STAMP.tar.gz")
    list=''
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        [ -e "$(T "$target")" ] && list="$list $(T "$target")"
    done <<EOF
$MANIFEST
EOF
    [ -e "$(T "$SNAPSHOT")" ] && list="$list $(T "$SNAPSHOT")"
    hook=$(T "/etc/systemd/system-shutdown/zz-s2-dtb-guard.sh")
    [ -e "$hook" ] && list="$list $hook"
    [ -e "$(T "$FNENV")" ] && list="$list $(T "$FNENV")"
    [ -e "$(T "$GUARD_CONF")" ] && list="$list $(T "$GUARD_CONF")"
    [ -e "$(T "$GUARD_STATE")" ] && list="$list $(T "$GUARD_STATE")"
    # shellcheck disable=SC2086
    [ -n "$list" ] && { tar -czPf "$tgz" $list || die "å¤‡ä»½å¤±è´¥ï¼Œä¸­æ­¢"; say "    $tgz  $(stat -c%s "$tgz") B"; }

    step 2 'äº¤è¿˜å‹åˆ¶ï¼ˆå…ˆæ”¾å›å¯¹æ–¹çš„é’©å­ï¼Œå†æ‹†è‡ªå·±ï¼‰'
    if [ -f "$(T "$GUARD")" ]; then
        bash "$(T "$GUARD")" --release 2>&1 | sed 's/^/    /'
    else
        say "    å®ˆå«è„šæœ¬å·²ä¸åœ¨ï¼Œè·³è¿‡ --release"
    fi

    step 3 'åœç”¨å®ˆæŠ¤'
    for u in $UNITS; do
        sys stop "$u"; sys disable "$u"
        printf '    %-32s enabled=%-10s\n' "$u" "$(u_state "$u")"
    done

    step 4 'fdtfile ä¸åšæ”¹åŠ¨ï¼ˆæˆ‘ä»¬çš„ DTB å…¼å®¹æ—§ç‰ˆï¼ŒæŠ˜å›æ—§ dtb åè€Œæ”¾å›ä¸€ä»½æœ‰ç¼ºé™·çš„è®¾å¤‡æ ‘ï¼‰'
    cur=$(grep -m1 '^fdtfile=' "$(T "$FNENV")" 2>/dev/null | cut -d= -f2-)
    say "    ä¿æŒ fdtfile=$cur"
    if [ -f "$(T "/boot/dtb/rockchip/${cur#rockchip/}")" ]; then
        say "    ç›®æ ‡æ–‡ä»¶å­˜åœ¨ï¼Œé‡å¯ç…§æ—§èƒ½èµ·æ¥"
    else
        say "    !! ä½† rockchip/${cur#rockchip/} ä¸å­˜åœ¨ï¼ˆä¸æ˜¯æœ¬åŒ…é€ æˆçš„ï¼Œè£…ä¹‹å‰å°±ä¸åœ¨ï¼‰"
    fi

    step 5 'åˆ æœ¬åŒ…çš„æ–‡ä»¶ï¼ˆ/boot ä¸‹çš„ dtb ä¸€å¾‹ä¿ç•™ï¼Œä¸è¿˜åŸæˆæ—§å­—èŠ‚ï¼‰'
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        p=$(T "$target"); base=$(basename "$p")
        case "$target" in
            /boot/dtb/rockchip/*)
                if [ -e "$p" ]; then
                    if [ "$(md5_of "$p")" = "$md5" ]; then
                        say "    ä¿ç•™ $targetï¼ˆæœ¬åŒ…é‚£ä»½å…¼å®¹ dtbï¼Œä¸è¿˜åŸï¼‰"
                    else
                        say "    ä¿ç•™ $targetï¼ˆå†…å®¹ä¸æ˜¯æœ¬åŒ…å†™çš„ï¼Œæ›´ä¸åŠ¨ï¼‰"
                    fi
                else
                    say "    å·²ä¸å­˜åœ¨ $target"
                fi
                rm -f "${p}.orig-bak" 2>/dev/null && say "    æ¸…æ‰ ${p}.orig-bakï¼ˆæ—§å­—èŠ‚å·²æ”¶è¿›å¤‡ä»½ tarï¼‰"
                continue ;;
            /var/lib/s2-dtb-guard/dtb.ref)
                # è¿™ä»½ç§æœ‰å‰¯æœ¬è¦ç•™ç€ï¼šå¸è½½å /boot çš„ dtb å’Œ fdtfile éƒ½ä¸åŠ¨ï¼Œ
                # OTA ä¸€æ—¦é‡åˆ· /boot/dtbï¼Œfdtfile å°±æŒ‡å‘ä¸å­˜åœ¨çš„æ–‡ä»¶ï¼Œè®¾å¤‡åœ¨ U-Boot é˜¶æ®µèµ·ä¸æ¥ã€‚
                if [ -e "$p" ]; then
                    say "    ä¿ç•™ $targetï¼ˆOTA é‡åˆ· /boot/dtb åå”¯ä¸€çš„è®¾å¤‡ä¾§å›å¡«æºï¼‰"
                else
                    say "    å·²ä¸å­˜åœ¨ $target"
                fi
                continue ;;
        esac
        [ -e "$p" ] || { say "    å·²ä¸å­˜åœ¨ $target"; continue; }
        if [ -e "${p}.orig-bak" ]; then
            cp -a "${p}.orig-bak" "$p" && say "    è¿˜åŸ $targetï¼ˆç”¨ .orig-bakï¼‰"
            rm -f "${p}.orig-bak"
        elif [ -e "$(T "$OLD_BK")/$base" ]; then
            cp -a "$(T "$OLD_BK")/$base" "$p" && say "    è¿˜åŸ $targetï¼ˆç”¨ $OLD_BKï¼‰"
        else
            rm -f -- "$p" && say "    removed $target"
        fi
    done <<EOF
$MANIFEST
EOF

    hook=$(T "/etc/systemd/system-shutdown/zz-s2-dtb-guard.sh")
    if [ -f "$hook" ] && grep -q 's2-dtb-guard.sh --shutdown' "$hook" 2>/dev/null; then
        rm -f "$hook" && say "    removed ${hook#$R}ï¼ˆæ—§ç‰ˆå…³æœºé’©å­ï¼Œå·²æ”¶è¿›å¤‡ä»½ tarï¼‰"
    fi

    step 6 'æ¸…å¯ç”¨é“¾æ¥ / é…ç½® / çŠ¶æ€ / å¿«ç…§'
    for d in "$R/etc/systemd/system" "$R/usr/lib/systemd/system" "$R/lib/systemd/system"; do
        [ -d "$d" ] || continue
        for t in multi-user.target timers.target shutdown.target reboot.target halt.target poweroff.target; do
            [ -d "$d/$t.wants" ] || continue
            find "$d/$t.wants" -maxdepth 1 -type l \
                 \( -name 'fix-fnenv*' -o -name 's2-dtb-guard*' -o -name 'scsi-rescan.service' \) 2>/dev/null \
            | while read -r l; do
                rm -f -- "$l" && say "    unlink ${l#$R}"
            done
        done
        find "$d" -maxdepth 2 -name '50-s2-dtb-guard.conf' -delete 2>/dev/null || true
    done
    rm -f "$(T "$GUARD_CONF")" && say "    removed $GUARD_CONF"
    rm -f "$(T "$SNAPSHOT")" && say "    removed $SNAPSHOT"
    # dtb.ref æ•…æ„ç•™ç€ï¼š/boot é‡Œçš„ dtb ä¸ fdtfile éƒ½ä¿æŒç°çŠ¶ï¼Œä¸€æ—¦ OTA é‡åˆ· /boot/dtbï¼Œ
    # fdtfile å°±æŒ‡å‘ä¸å­˜åœ¨çš„æ–‡ä»¶ï¼Œæ•…éšœå‘ç”Ÿåœ¨ U-Boot é˜¶æ®µï¼ˆè®¾å¤‡èµ·ä¸æ¥ï¼‰ï¼Œè®¾å¤‡ä¾§å¿…é¡»ç•™ä¸€ä»½
    # å‚è€ƒå‰¯æœ¬ï¼Œå¦åˆ™åªèƒ½é‡æ–°æŠŠ .run ä¼ ä¸Šå»æ‰æœ‰å­—èŠ‚å¯å›å¡«ã€‚å‡  KB çš„ä»£ä»·ï¼Œæ¢ä¸€æ¡è‡ªæ•‘è·¯ã€‚
    refkeep=''
    if [ -f "$(T "$GUARD_STATE")/dtb.ref" ]; then
        refkeep=$(mktemp) && cp -a "$(T "$GUARD_STATE")/dtb.ref" "$refkeep" \
            || { refkeep=''; say "    !! æš‚å­˜ dtb.ref å¤±è´¥ï¼ŒéšçŠ¶æ€ç›®å½•ä¸€èµ·åˆ ï¼ˆå¤‡ä»½ tar é‡Œè¿˜æœ‰ä¸€ä»½ï¼‰"; }
    fi
    rm -rf "$(T "$GUARD_STATE")" && say "    removed $GUARD_STATEï¼ˆå«éš”ç¦»åŒº / å¿«ç…§ / å®‰è£…çŠ¶æ€ï¼‰"
    if [ -n "$refkeep" ]; then
        mkdir -p "$(T "$GUARD_STATE")" && cp -a "$refkeep" "$(T "$GUARD_STATE")/dtb.ref" \
            && chmod 644 "$(T "$GUARD_STATE")/dtb.ref" 2>/dev/null || true
        rm -f "$refkeep"
        if [ -f "$(T "$GUARD_STATE")/dtb.ref" ]; then
            say "    ä¿ç•™ $GUARD_STATE/dtb.ref  $(stat -c%s "$(T "$GUARD_STATE")/dtb.ref") B"
            say "      èµ·ä¸æ¥æ—¶å›å¡«ï¼š sudo install -D -m 644 $GUARD_STATE/dtb.ref /boot/dtb/rockchip/$(basename "$DTB_TARGET")"
        fi
    fi
    if live; then systemctl daemon-reload >/dev/null 2>&1 || true; systemctl reset-failed >/dev/null 2>&1 || true; fi

    step 7 'æ ¡éªŒ'
    bad=0
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        p=$(T "$target")
        case "$target" in
            /boot/dtb/rockchip/*) continue ;;   # dtb æ˜¯æ•…æ„ä¿ç•™çš„ï¼Œä¸ç®—æ®‹ç•™
            /var/lib/s2-dtb-guard/dtb.ref) continue ;;   # å›å¡«æºï¼Œæ•…æ„ä¿ç•™
        esac
        [ -e "$p" ] && { say "    !! æ®‹ç•™ $target"; bad=1; }
    done <<EOF
$MANIFEST
EOF
    [ -e "$(T "$GUARD_CONF")" ] && { say "    !! æ®‹ç•™ $GUARD_CONF"; bad=1; }
    if [ -e "$(T "$GUARD_STATE")" ]; then
        extra=$(find "$(T "$GUARD_STATE")" -mindepth 1 ! -name dtb.ref 2>/dev/null | head -n 1)
        if [ -n "$extra" ]; then
            say "    !! æ®‹ç•™ $GUARD_STATE/${extra##*/}"; bad=1
        elif [ -f "$(T "$GUARD_STATE")/dtb.ref" ]; then
            say "    ä¿ç•™ $GUARD_STATE/dtb.refï¼ˆæ•…æ„ç•™ç€ï¼ŒOTA é‡åˆ· /boot/dtb åçš„å›å¡«æºï¼‰"
        fi
    fi
    fv=$(grep -m1 '^fdtfile=' "$(T "$FNENV")" | cut -d= -f2-)
    if [ -f "$(T "/boot/dtb/rockchip/${fv#rockchip/}")" ]; then
        say "    fdtfile=$fv  ç›®æ ‡å­˜åœ¨ OKï¼ˆå¼•å¯¼é“¾å®Œæ•´ï¼‰"
    else
        say "    !! fdtfile=$fv  ç›®æ ‡ä¸å­˜åœ¨"; bad=1
    fi
    say "    ä¿ç•™çš„ dtb:"
    while IFS='|' read -r mode target src md5; do
        [ -n "${mode:-}" ] || continue
        case "$target" in /boot/dtb/rockchip/*) ;; *) continue ;; esac
        p=$(T "$target")
        say "      $target  $( [ -f "$p" ] && printf '%s  %s B' "$(md5_of "$p")" "$(stat -c%s "$p")" || echo ç¼ºå¤±)"
    done <<EOF
$MANIFEST
EOF
    say "    è¿è¡Œæ€ modelï¼ˆé‡å¯å‰è¿˜æ˜¯æ—§çš„ï¼‰: $(model_now)"
    [ "$bad" -eq 0 ] && say "    âœ… å¸è½½å¹²å‡€ï¼šæœ¬åŒ…é’©å­/è„šæœ¬/é…ç½®å…¨æ‹†ï¼Œdtb æŒ‰ä½ çš„è¦æ±‚ä¿ç•™ï¼ˆå…¼å®¹æ—§ç‰ˆï¼Œä¸è¿˜åŸï¼‰"
    say "  å›æ»šï¼š tar -xzPf $tgz ; sudo bash $0 --install ; reboot"
    [ "$bad" -eq 0 ] || exit 1
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print} NR>1 && !/^#/ {exit}' "$0"; }

DRYRUN=0; YES=0; CMD=''
for a in "$@"; do
    case "$a" in
        --check) cmd_check; exit 0 ;;
        --status|--verify) cmd_status; exit 0 ;;
        --dry-run|-n) DRYRUN=1 ;;
        --yes|-y) YES=1 ;;
        --install|-i) CMD=install ;;
        --uninstall|-u|--remove) CMD=uninstall ;;
        --help|-h) usage; exit 0 ;;
        --version|-V) echo "S2è‡ªæ„ˆæœ€å°åŒ… v$VERSION  dtb=$DTB_MD5  payload=$PAYLOAD_SHA256"; exit 0 ;;
        '') ;;
        *) echo "æœªçŸ¥å‚æ•°ï¼š$a" >&2; usage; exit 2 ;;
    esac
done

[ -n "${CMD:-}" ] || CMD=install   # çª—å£é‡Œç‚¹ã€Œè¿è¡Œã€ä¸å¸¦å‚æ•° â†’ ç›´æ¥å®‰è£…
case "$CMD" in
    install)   [ "$DRYRUN" = 1 ] && say "(dry-run: ä¸åšå®é™…å†™å…¥)"; cmd_install ;;
    uninstall) cmd_uninstall ;;
    *) usage; exit 2 ;;
esac
# è„šæœ¬æ­£æ–‡åˆ°æ­¤ç»“æŸï¼šä¸‹é¢è¿™è¡Œå…ˆé€€å‡ºï¼Œåˆ«è®© shell ç»§ç»­è§£æåé¢çš„äºŒè¿›åˆ¶è½½è·
exit $?
