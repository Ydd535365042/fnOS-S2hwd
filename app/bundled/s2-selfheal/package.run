T()    { printf '%s%s' "$R" "$1"; }                  # è®¾å¤‡è·¯å¾„ â†’ å¸¦æ²™ç®±å‰ç¼€
need_root() { [ -n "$R" ] && return 0; [ "$(id -u)" = 0 ] || die "è¯¥æ“ä½œéœ€è¦ rootï¼šsudo bash $0 $1"; }
live() { [ -n "${S2_FORCE_LIVE:-}" ] && return 0; [ -z "$R" ] && [ -d /run/systemd/system ]; }
sys()  { if live; then systemctl "$@" >/dev/null 2>&1 || true; else say "    (æ²™ç®±) would: systemctl $*"; fi; }
sysq() { live && systemctl "$@" >/dev/null 2>&1; }
u_state() { if live; then systemctl is-enabled "$1" 2>&1 | head -n1; else echo "sandbox"; fi; }
unlock_file() {   # immutable ä¼šè®©å†…æ ¸ç›´æ¥æ‹’å†™
    local p="$1" a
    [ -f "$p" ] || return 0
    command -v lsattr >/dev/null 2>&1 || return 0
    a=$(lsattr -d "$p" 2>/dev/null | awk '{print $1}')
    case "$a" in *i*) chattr -i "$p" 2>/dev/null && say "    è§£é’‰ $pï¼ˆåŸä¸º chattr +iï¼‰" || say "    !! $p è§£ä¸å¼€ immutable" ;; esac
}
md5_of() { md5sum "$1" 2>/dev/null | awk '{print $1}'; }
model_now() { tr -d '\0' 2>/dev/null < "$R/proc/device-tree/model"; }
# /boot åœ¨ fnOS ä¸Šå¸¸æ˜¯åªè¯»æŒ‚è½½ã€‚å®‰è£…è¦å¾€é‡Œå†™ dtb å’Œ fnEnvï¼Œå†™å‰å¿…é¡»è‡ªå·±æŠŠå®ƒæŒ‚æˆå¯å†™ï¼Œ
# å†™å®Œå†æŒ‚å›åªè¯»â€”â€”å¦åˆ™ä¼šä¸€è·¯ die åœ¨ã€Œå†™å…¥å¤±è´¥ã€æˆ–ã€Œå†™å…¥åè¢«æ”¹å›ã€ï¼Œçœ‹èµ·æ¥åƒ immutableã€‚
BOOT_RW=0
boot_rw() {
    live || return 0
    [ "$BOOT_RW" = 1 ] && return 0
    mount | grep -qE ' /boot (.*,)?ro([ ,]|$)' || return 0
    if mount -o remount,rw /boot >/dev/null 2>&1; then
        BOOT_RW=1; say "    /boot åŸä¸ºåªè¯»ï¼Œå·²ä¸´æ—¶ remount rw"
    else
        say "    âš  /boot æ˜¯åªè¯»ä¸” remount å¤±è´¥ï¼Œåé¢å†™ /boot çš„æ­¥éª¤ä¼šå¤±è´¥"
    fi
}
boot_ro() {
    [ "$BOOT_RW" = 1 ] || return 0
    if mount -o remount,ro /boot >/dev/null 2>&1; then
        say "    /boot å·²æŒ‚å›åªè¯»"
    else
        say "    âš  /boot æœªèƒ½æŒ‚å›åªè¯»ï¼ˆä¸å½±å“å¼€æœºï¼Œåªæ˜¯å’Œè£…å‰çŠ¶æ€ä¸åŒï¼‰"
    fi
    BOOT_RW=0
}

TMPDIR_PAYLOAD=''
cleanup() { [ -n "$TMPDIR_PAYLOAD" ] && rm -rf "$TMPDIR_PAYLOAD"; }
